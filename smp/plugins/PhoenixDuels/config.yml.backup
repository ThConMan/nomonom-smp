#                                                                         
# This is a configuration file that allows you to configure the PhoenixDuels plugin
# Website: https://www.phoenixplugins.com
# Discord: https://www.phoenixplugins.com/media/discord
#

product-license: DPT5A-BQ8KT-RLCMB-VX4UC
notify-if-new-version: true
debug: false
database:
  type: sqlite
  address: localhost
  name: phoenixduels_db
  port: 3306
  username: phoenixuser
  password: phoenixpassword
  table-prefix: ''
  hikari:
    maximumPoolSize: 20
    minimumIdle: 5
    idleTimeout: 600000
    maxLifetime: 1800000
    connectionTimeout: 30000
    fetch-timeout: 5000
performance:
  thread-pool-size: 10
  thread-pool-timeout-millis: 10000
worlds:
  should-use: DISABLED_WORLDS
  enabled: []
  disabled:
  - world_nether
party:
  default-slots: 5
  permission-slots:
    '0':
      amount: 10
      permission: phoenixduels.partymembers.10
    '1':
      amount: 15
      permission: phoenixduels.partymembers.15
allowed-types:
- CHALLENGE
- UNRANKED
- RANKED
match:
  default-finishing-seconds: 5
  extended-finishing-seconds: 60
  commands:
    mode: WHITELIST
    whitelist-commands: []
    blacklist-commands: []
  restore-last-inventory: true
  launch-fireworks-for-winner: true
  custom-nametags:
    enabled: true
    prefix: '%color%[%team%] '
betting:
  money-enabled: true
  items-enabled: true
items-betting:
  max-items-per-player: 10
cache:
  use-memory-for-performance: true
stats-update-interval: 60
commands:
  require-permission: false
  duel:
    enabled: true
    alternative: duel
  queue:
    enabled: true
    alternative: queue
  duelsettings:
    enabled: true
    alternative: duelsettings
  lostitems:
    enabled: true
    alternative: duellostitems
  toggleduelrequest:
    enabled: true
    alternative: toggleduelrequest
  kiteditor:
    enabled: true
    alternative: kiteditor
  stats:
    enabled: true
    alternative: stats
  spectate:
    enabled: true
    alternative: spectate
  party:
    enabled: true
    alternative: party
  leave:
    alternative: leave
invitation-expiration-time: 60
ranked:
  unranked-requirement:
    enabled: false
    amount: 10
    bypass-permission: phoenixduels.ranked.bypass
leaderboard-fetch-interval: 60
